{
  "name": "@zerwiz/odrerir",
  "type": "module",
  "version": "0.1.2",
  "description": "\u00d3\u00f0rerir \u2014 the Ymir fleet's board on its own deck: the landing's carved cloth, the board's machinery, read-only.",
  "main": "electron/main.cjs",
  "scripts": {
    "check:cloth": "node scripts/extract-cloth.mjs --check",
    "dev": "npm run check:cloth && astro dev",
