    "preview": "astro preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "astro": "latest"
  },
  "files": [
    "dist",
    "electron",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}